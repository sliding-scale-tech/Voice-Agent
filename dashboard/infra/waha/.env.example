# Copy to .env in this folder, then: docker compose up -d
#
# WAHA_API_KEY is the shared secret in both directions:
#   - we send it to WAHA as the X-Api-Key header on every REST call
#   - WAHA sends it back to us on the webhook, and convex/http.ts rejects calls without it
# Generate one with:  openssl rand -hex 16
WAHA_API_KEY=replace-me

# WAHA's own dashboard at http://localhost:3001 — handy for watching sessions and raw
# webhook payloads while debugging. Not used by the app.
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=replace-me

# Host port to publish WAHA on. Only change this if something else on the box already uses
# 3001 - vps-inspect.sh will tell you. It is bound to 127.0.0.1, never the public interface.
WAHA_HOST_PORT=3001
